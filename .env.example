# Food Companion Environment Configuration
# Copy this file to .env to enable optional AI vision features:
#   cp .env.example .env

# Optional: Google Gemini Multimodal Vision API Key
# If set, Analyze Mode uses Gemini 1.5 Flash vision to identify dishes against the 189 reference foods.
# If left unset or blank, Food Companion uses its built-in reference feature matcher (Canvas color, texture, and visual descriptors).
# Get a key from: https://aistudio.google.com/
VITE_GEMINI_API_KEY=
